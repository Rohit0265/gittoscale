# ==============================================================================
# System Design Playground - Environment Configuration
# ==============================================================================

# LLM Provider configuration: 'openai' | 'gemini' | 'anthropic'
LLM_PROVIDER=openai

# Model selection (e.g. gpt-4o-mini, gpt-4o, gemini-1.5-flash, claude-3-5-sonnet-20241022)
LLM_MODEL=gpt-4o-mini

# Your LLM API Key (used for analyzing repositories and classifying servers vs folders)
# You can also use provider-specific variables:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
LLM_API_KEY=

# Server Port (default 3000)
PORT=3000

# ==============================================================================
# Telegram Notifications (Optional)
# ==============================================================================
# Messages sent from the feedback modal will be forwarded directly to your Telegram.
# 1. Message @BotFather on Telegram -> /newbot to create a bot and get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot or @RawDataBot to get your numeric TELEGRAM_CHAT_ID
# 3. Start a chat with your bot by sending /start so it has permission to message you
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

