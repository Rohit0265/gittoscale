# ==============================================================================
# GitToScale - Complete Project Environment Variables
# ==============================================================================

# Server configuration
PORT=3000

# ------------------------------------------------------------------------------
# Supabase Authentication & PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Supabase Project URL (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Safe for browser client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Secret / Service Role Key (Backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Managed PostgreSQL Direct Connection (Optional: for migrations/CLI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# AI Provider Configuration (System Design & Codebase Analysis)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here

GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

# Inception Labs Mercury-3 (Fast Diffusion LLM)
MERCURY_API_KEY=
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-3

# ------------------------------------------------------------------------------
# GitHub Integration (Optional - higher rate limits for public repos)
# ------------------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# Cloudflare R2 Object Storage (For Social Feed Post Media)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# Feedback & Notifications (Optional)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
