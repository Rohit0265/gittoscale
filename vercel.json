{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": "backend",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api",
        "path": "/api/:path*"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "web",
        "path": "/:path*"
      }
    }
  ]
}
